<?xml version="1.0" encoding="utf-8"?>
<!--
    API 31+ (Android 12+) backup/transfer exclusion rules.

    Excludes:
    - The entire "database" domain: the SQLCipher-encrypted Room DB
      (SecureDatabase.kt -> "secure_signal.db") plus its -wal/-shm/-journal
      siblings. Excluding the whole domain avoids having to enumerate journal
      files by name.
    - The "signalgate_secure_prefs" SharedPreferences file: holds the
      Keystore-wrapped DB passphrase (ciphertext + IV) written by
      SecurityUtils.kt. The wrapping key itself never leaves AndroidKeystore,
      but restoring this ciphertext onto a device where that key doesn't
      exist would desync it from the (also-excluded) database, so it is
      excluded too rather than relying on that alone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="sharedpref" path="signalgate_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" path="signalgate_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
