<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Splash/starting-window theme. MainActivity is launched with this theme
         (see AndroidManifest.xml); installSplashScreen() in MainActivity.kt
         switches to postSplashScreenTheme once the app is ready to draw.

         This covers the wait during MainApplication.onCreate()'s runBlocking
         DB init (see that class's doc comment) — the system shows this themed
         starting window for the app's entire cold-start duration, including
         that blocking period, with zero additional code required for that part.
         The keepOnScreenCondition in MainActivity is an additional safety net
         for any residual work after the first Activity frame. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/shield_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.SignalGate</item>
    </style>

    <!-- Main App Theme -->
    <style name="Theme.SignalGate" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Material Colors -->
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorPrimaryDark">@color/color_primary_dark</item>
        <item name="colorAccent">@color/accent_secondary</item>

        <!-- Backgrounds -->
        <item name="android:windowBackground">@color/background_primary</item>
        <item name="android:statusBarColor">@color/background_primary</item>
        <item name="android:navigationBarColor">@color/background_secondary</item>

        <!-- Surface Colors -->
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Custom Design System Attributes -->
        <item name="background_primary">@color/background_primary</item>
        <item name="background_secondary">@color/background_secondary</item>
        <item name="card_background">@color/card_background</item>
        <item name="text_muted">@color/text_muted</item>

        <item name="accent_primary">@color/accent_primary</item>
        <item name="accent_secondary">@color/accent_secondary</item>

        <item name="overlay_glass">@color/overlay_glass</item>
        <item name="nav_selected">@color/nav_selected</item>
        <item name="divider_color">@color/divider_color</item>

        <item name="shield_active">@color/shield_active</item>
        <item name="shield_inactive">@color/shield_inactive</item>

    </style>

</resources>
