<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!--
        Header wordmark icon — a 5-bar audio/signal pulse, matching the
        design mockup's "waveform" mark (replaces the old ic_signal_gate_logo
        raster, which was actually a wide SignalGate Pulse promo banner
        misused as a small icon, and the SG shield, which is the hero-graphic
        mark, not the header brand mark).

        Vector, not raster: scales cleanly from 24dp to 56dp+ with no alpha
        fringing/halo risk (see shield_logo.png's earlier transparency bug).

        Bars are drawn as round-capped strokes (not filled rounded rects) —
        simpler pathData, same visual result. Heights taper short → tallest
        (center) → short, same silhouette as the mockup. Each bar shares an
        identical top-to-bottom linear gradient (NeonCyan → AccentPrimary,
        see ui/theme/Color.kt and SignalGateTheme.kt) so the five bars read
        as one continuous gradient rather than five separately-colored bars.
    -->
    <path
        android:pathData="M4.4,9 L4.4,15"
        android:strokeWidth="2.6"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="0" android:endY="24"
                android:startColor="#FF00E5FF"
                android:endColor="#FF00A3FF" />
        </aapt:attr>
    </path>
    <path
        android:pathData="M8.2,6 L8.2,18"
        android:strokeWidth="2.6"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="0" android:endY="24"
                android:startColor="#FF00E5FF"
                android:endColor="#FF00A3FF" />
        </aapt:attr>
    </path>
    <path
        android:pathData="M12,3 L12,21"
        android:strokeWidth="2.6"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
