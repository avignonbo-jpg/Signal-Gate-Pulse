<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Core telephony permissions -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />

    <!-- Notifications — POST_NOTIFICATIONS is all that is needed for Step 1.8.
         The overlay window permission has been intentionally omitted. SignalGate
         Pulse does not draw over other apps. Any PR reintroducing an overlay
         permission should be blocked — see Architecture Contract v5. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Contacts -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
        Removed (verified unused, 2025): FOREGROUND_SERVICE, FOREGROUND_SERVICE_PHONE_CALL,
        FOREGROUND_SERVICE_DATA_SYNC, MANAGE_OWN_CALLS.

        None of these are exercised anywhere in the codebase:
          - The app has exactly one Service — SignalGateCallScreeningService — which is a
            *bound* android.telecom.CallScreeningService (invoked by Telecom via
            BIND_SCREENING_SERVICE), not something the app starts in the foreground.
            No startForeground()/setForeground() call exists anywhere in the codebase.
          - CommunitySyncWorker is a plain background CoroutineWorker (WorkManager
            schedules it with network+battery constraints); it never calls
            setForeground()/ForegroundInfo despite the removed FOREGROUND_SERVICE_DATA_SYNC
            permission's comment claiming a "Phase 4.9 prereq" — that phase reference
            doesn't correspond to anything in the actual release plan, so there was no
            tracked work backing it.
          - MANAGE_OWN_CALLS (self-managed ConnectionService / custom call UI) has zero
            references — no ConnectionService, PhoneAccount, or TelecomManager usage
            anywhere. Consistent with this being left over from a removed call-overlay
            feature.

        If a future feature genuinely needs one of these (e.g. CommunitySyncWorker
        upgraded to run as an expedited/foreground work request on API 34+), re-add the
        specific permission alongside the code that actually calls setForeground()/
        ForegroundInfo — don't restore this whole block speculatively.
    -->

    <!-- Phase 4.11: ensures CommunitySyncWorker is rescheduled after device reboot.
         WorkManager auto-reschedules on boot in most cases, but some OEMs
         (Samsung, Xiaomi) kill this path on Android 12+. The explicit
         BOOT_COMPLETED broadcast to SyncBootReceiver is the guarantee. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/shield_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/shield_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.SignalGate"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Single Activity — contract requirement.
             android:theme="@style/Theme.App.Starting" — launched with the splash
             theme; installSplashScreen() in MainActivity.kt switches to
             Theme.SignalGate (declared as postSplashScreenTheme) once ready. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.App.Starting"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="signalgate"
                    android:host="digest" />
            </intent-filter>

        </activity>

        <service
            android:name=".SignalGateCallScreeningService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".PhoneStateReceiver"
            android:permission="android.permission.READ_PHONE_STATE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />

        <!-- Phase 4.11: reschedules CommunitySyncWorker after reboot and app update.
             BOOT_COMPLETED fires after reboot. MY_PACKAGE_REPLACED fires after OTA
             update — OS does NOT send BOOT_COMPLETED on update, so both are needed.
             exported=true required for BOOT_COMPLETED on Android 12+. -->
        <receiver
            android:name=".workers.SyncBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
